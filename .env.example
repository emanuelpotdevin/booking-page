# Copy to .env.local for local development. On Vercel, add these under Settings → Environment Variables.

# From Google Cloud → APIs & Services → Credentials → OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The Google account that owns this booking page (only this account can open /admin)
OWNER_EMAIL=

# Any long random string (used to sign your login cookie)
SESSION_SECRET=

# Added automatically when you connect Upstash Redis in Vercel → Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=
